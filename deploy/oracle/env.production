# .env delle API sulla VM Oracle. provision.sh lo copia in /srv/duemani/api/.env
# e riempie i segreti (APP_KEY, DB_PASSWORD): qui non c'è nessun segreto.
APP_NAME=duemani
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Rome
APP_URL=https://duemani.duckdns.org

# L'app su GitHub Pages (l'origin è senza percorso: niente /rasta)
CORS_ALLOWED_ORIGINS=https://lorenzoalulithos.github.io

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=duemani
DB_USERNAME=duemani
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
