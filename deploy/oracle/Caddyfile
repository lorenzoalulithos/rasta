# API duemani su Oracle Always Free (docs/stack.md "Ambiente di prova").
# Caddy prende e rinnova da solo il certificato HTTPS per il dominio DuckDNS.
duemani.duckdns.org {
	root * /srv/duemani/api/public
	encode zstd gzip
	php_fastcgi unix//run/php/php8.5-fpm.sock
	file_server

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /var/log/caddy/duemani.log
	}
}
